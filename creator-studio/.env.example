# Runtime: development | test | preview | production
CREATOR_RUNTIME_MODE=development
NEXT_PUBLIC_CREATOR_RUNTIME_MODE=development

# Supabase. Keep the service-role key server-side only.
NEXT_PUBLIC_SUPABASE_URL=https://example.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-me
SUPABASE_SERVICE_ROLE_KEY=replace-me

# Explicit local/demo authority. Must be false in preview/production.
CREATOR_ENABLE_DEMO_MODE=true

# Worker. Real provider execution remains disabled by default.
CREATOR_WORKER_BASE_URL=http://127.0.0.1:8090
CREATOR_WORKER_TOKEN=replace-with-a-long-random-value
CREATOR_PROVIDER_MODE=mock

# Optional future BYOK script provider. No provider is required for M0-M1.
SCRIPT_PROVIDER=manual
SCRIPT_PROVIDER_API_KEY=
