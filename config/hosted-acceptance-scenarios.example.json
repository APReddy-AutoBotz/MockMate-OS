      "expectedStatuses": [
        200
      ],
      "assertions": [
        {
          "source": "json",
          "path": "/score",
          "op": "type",
          "value": "number"
        }
      ],
      "body": {
        "resumeText": "__CONTROLLER_REPLACE_BOUNDED_TEXT__",
        "jobDescription": "__CONTROLLER_REPLACE_BOUNDED_JOB__"
      }
    },
    {
      "id": "resume-suggest",
      "family": "resume",
      "operation": "resume.suggest",
      "method": "POST",
      "path": "/api/resume/suggest",
