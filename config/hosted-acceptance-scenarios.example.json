{
  "schemaVersion": 3,
  "description": "Controller-reviewed template only. Replace every placeholder with bounded synthetic exact-target data. Semantic response/state data is inspected only in memory; tokens, response bodies, resumes, and audio are never persisted to evidence. Account deletion and aftermath cases must remain last.",
  "scenarios": [
    {
      "id": "runtime-health",
      "family": "runtime",
      "operation": "runtime.health",
      "method": "GET",
      "path": "/api/health",
      "auth": "none",
      "expectedStatuses": [
        200
      ],
      "assertions": [
        {
          "source": "json",
          "path": "/mode",
          "op": "equals",
          "value": "preview"
        },
        {
          "source": "json",
          "path": "/authority",
          "op": "equals",
          "value": "configured"
        }
      ]
    },
    {
      "id": "pwa-manifest",
      "family": "pwa",
      "operation": "pwa.manifest",
      "method": "GET",
      "path": "/manifest.json",
      "auth": "none",
      "expectedStatuses": [
        200
      ],
      "assertions": [
        {
          "source": "json",
          "path": "/icons",
          "op": "type",
          "value": "array"
        }
      ]
    },
    {
      "id": "pwa-offline",
      "family": "pwa",
      "operation": "pwa.offline",
      "method": "GET",
      "path": "/offline.html",
      "auth": "none",
      "expectedStatuses": [
        200
      ],
      "assertions": [
        {
          "source": "text",
          "op": "includes",
          "value": "MockMate"
        }
      ]
    },
    {
      "id": "auth-identity",
      "family": "auth",
      "operation": "auth.identity",
      "method": "GET",
