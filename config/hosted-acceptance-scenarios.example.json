      "body": {
        "resumeText": "__CONTROLLER_REPLACE_BOUNDED_TEXT__",
        "jobDescription": "__CONTROLLER_REPLACE_BOUNDED_JOB__"
      }
    },
    {
      "id": "clearspeak-create",
      "family": "clearspeak",
      "operation": "clearspeak.create",
      "method": "POST",
      "path": "/api/clearspeak/v1/accent/attempts",
      "auth": "userA",
      "expectedStatuses": [
        200,
        201,
        202
      ],
      "assertions": [
        {
          "source": "json",
          "path": "/attemptId",
          "op": "type",
          "value": "string"
        }
      ],
      "multipart": {
        "fileEnv": "CLEARSPEAK_FIXTURE_PATH",
        "fileField": "audio",
        "filename": "bounded-audio.webm",
        "contentType": "audio/webm",
        "fields": {
          "promptId": "__CONTROLLER_REPLACE_PROMPT_ID__",
          "idempotencyKey": "__CONTROLLER_REPLACE_ATTEMPT_KEY__"
        }
      }
