    {
      "id": "clearspeak-result",
      "family": "clearspeak",
      "operation": "clearspeak.result",
      "method": "GET",
      "path": "/api/clearspeak/v1/accent/attempts/__CONTROLLER_REPLACE_ATTEMPT_ID__/status",
      "auth": "userA",
      "expectedStatuses": [
        200
