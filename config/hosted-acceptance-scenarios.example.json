        200
      ],
      "assertions": [
        {
          "source": "json",
          "path": "/user/uid",
          "op": "equals",
          "value": "__CONTROLLER_REPLACE_USER_A_ID__"
        }
      ]
    },
    {
      "id": "resume-parse",
      "family": "resume",
      "operation": "resume.parse",
      "method": "POST",
      "path": "/api/resume/parse",
      "auth": "userA",
      "expectedStatuses": [
        200
      ],
      "assertions": [
