{
  "name": "mockmate-shared",
  "version": "1.0.0",
  "main": "dist-cjs/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist-cjs/index.js",
      "default": "./dist/index.js"
    },
    "./resume-integrity": {
      "types": "./dist/resumeIntegrity.d.ts",
      "import": "./dist/resumeIntegrity.js",
      "require": "./dist-cjs/resumeIntegrity.js",
      "default": "./dist/resumeIntegrity.js"
    },
    "./accent-evidence": {
      "types": "./dist/accentEvidence.d.ts",
      "import": "./dist/accentEvidence.js",
      "require": "./dist-cjs/accentEvidence.js",
      "default": "./dist/accentEvidence.js"
    }
  },
  "typesVersions": {
    "*": {
      "resume-integrity": [
        "dist/resumeIntegrity.d.ts"
      ],
      "accent-evidence": [
        "dist/accentEvidence.d.ts"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.cjs",
    "dev": "tsc -w",
    "test": "jest --forceExit",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "typescript": "^5.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "@types/jest": "^29.5.12"
  }
}
