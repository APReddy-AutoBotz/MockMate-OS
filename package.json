{
  "name": "mockmate-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run shared:build && vite build",
    "typecheck": "tsc --noEmit",
    "verify:supabase": "node scripts/verify-supabase-migration.mjs",
    "verify:supabase:runtime": "node scripts/verify-supabase-runtime.mjs",
    "test:clearspeak-p0-5-db": "node scripts/test-clearspeak-real-speech-db-contract.mjs",
    "smoke:production": "node scripts/production-smoke.mjs",
    "test:runtime-config-static": "node scripts/test-runtime-config-static.mjs",
    "test:production-auth-rejection": "node scripts/test-production-auth-rejection.mjs",
    "test:browser-runtime": "node scripts/test-browser-runtime.mjs",
    "test:adaptive-api-journey": "node scripts/test-adaptive-api-journey.mjs",
    "test:adaptive-ui-journey": "node scripts/test-adaptive-ui-journey.mjs",
    "test:clearspeak-ui-journey": "node scripts/test-clearspeak-ui-journey.mjs",
    "test:adaptive-journey": "npm run test:adaptive-api-journey && npm run test:adaptive-ui-journey",
    "test:rejection-checks": "node scripts/test-rejection-checks.mjs",
    "test:career-context-account-deletion": "node scripts/test-career-context-account-deletion.mjs",
    "test:career-context-api-journey": "node scripts/test-career-context-api-journey.mjs",
    "test:resume-interview-journey": "node scripts/test-resume-interview-grounding-journey.mjs",
    "test:resume-clearspeak-journey": "node scripts/test-resume-clearspeak-grounding-journey.mjs",
    "test:clearspeak-interview-journey": "node scripts/test-clearspeak-interview-grounding-journey.mjs",
    "test:career-context-journeys": "npm run test:rejection-checks && npm run test:career-context-api-journey && npm run test:resume-interview-journey && npm run test:resume-clearspeak-journey && npm run test:clearspeak-interview-journey && npm run test:career-context-account-deletion",
    "test:shared-runtime-load": "node scripts/test-shared-runtime-load.cjs",
    "test:mobile-governed-parity": "node scripts/test-mobile-governed-parity.mjs",
    "scan:secrets": "node scripts/scan-git-history.mjs",
    "smoke:deployed": "node scripts/deployed-smoke.mjs",
    "test:preview-security": "node scripts/production-preview-security.mjs",
    "test:runtime-mode-authority": "node scripts/test-runtime-mode-authority.mjs",
    "test:hosted-operation-authority": "node scripts/test-hosted-operation-authority.mjs",
    "test:hosted-acceptance-contract": "node scripts/test-hosted-acceptance-guard.mjs && npm run test:hosted-operation-authority",
    "acceptance:hosted": "node scripts/hosted-preview-acceptance.mjs",
    "manifest:readiness": "node scripts/readiness-manifest.mjs",
    "check:preview-readiness": "npm run check:production && npm run audit:production && npm run check:mobile && npm run test:preview-security && npm run smoke:deployed && npm run manifest:readiness",
    "check:production": "npm run check:contracts && npm run shared:test && npm run shared:build && npm run test:shared-runtime-load && npm run typecheck && npm test -- --runInBand && npm run verify:supabase && npm run verify:supabase:runtime && npm run test:clearspeak-p0-5-db && npm run build && cd backend && npm run build && cd .. && npm run test:runtime-config-static && npm run test:browser-runtime && npm run test:adaptive-api-journey && npm run test:adaptive-ui-journey && npm run test:career-context-journeys && cd backend && npm test && cd .. && npm run smoke:production && npm run scan:secrets",
    "audit:production": "npm audit --omit=dev && cd backend && npm audit --omit=dev",
    "mobile:typecheck": "cd mobile && npx tsc --noEmit",
    "mobile:lint": "cd mobile && npm run lint",
    "check:mobile": "cd mobile && npm ci && npx tsc --noEmit && npm run lint && cd .. && npm run test:mobile-governed-parity",
    "check:release": "npm run check:production && npm run audit:production && npm run check:mobile",
    "preview": "vite preview",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "shared:build": "npm run build --workspace=mockmate-shared",
    "shared:test": "npm run test --workspace=mockmate-shared",
    "check:contracts": "npm run typecheck --workspace=mockmate-shared",
    "check:clearspeak-v1": "npm run check:contracts && npm run shared:test && npm run shared:build && npm run typecheck && cd backend && npm run build && npm test -- --runTestsByPath tests/clearSpeakAccentV1.test.ts"
  },
  "dependencies": {
    "@google/genai": "^1.40.0",
    "@supabase/supabase-js": "^2.105.3",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/morgan": "^1.9.10",
    "buffer": "^6.0.3",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "docx": "^9.6.1",
    "dotenv": "^16.6.1",
    "express": "^4.22.1",
    "file-saver": "^2.0.5",
    "framer-motion": "^11.3.11",
    "groq-sdk": "^1.1.2",
    "helmet": "^7.2.0",
    "i18next": "^25.7.3",
    "i18next-browser-languagedetector": "^8.2.0",
    "lucide-react": "^0.562.0",
    "mammoth": "^1.12.0",
    "mockmate-shared": "file:shared",
    "morgan": "^1.10.1",
    "multer": "^2.1.1",
    "node-fetch": "^3.3.2",
    "openai": "^6.34.0",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^16.5.0",
    "recharts": "^3.3.0"
  },
  "devDependencies": {
    "@emotion/babel-plugin": "^11.13.5",
    "@emotion/react": "^11.14.0",
    "@playwright/test": "^1.57.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^25.0.3",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.1.2",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-util": "^29.7.0",
    "pg": "^8.22.0",
    "pg-mem": "^3.0.14",
    "ts-jest": "^29.4.11",
    "ts-morph": "^28.0.0",
    "typescript": "^5.3.3",
    "vite": "^5.1.0",
    "vite-plugin-pwa": "^1.2.0",
    "workbox-window": "^7.4.0"
  },
  "workspaces": [
    "shared",
    "backend"
  ],
  "overrides": {
    "brace-expansion": "^2.0.1"
  }
}
